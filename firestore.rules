rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function rolePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function ownerPath() {
      return /databases/$(database)/documents/_system/owner;
    }

    function isLegacyOwner() {
      return signedIn()
        && exists(ownerPath())
        && get(ownerPath()).data.uid == request.auth.uid;
    }

    function hasAdminRole() {
      return signedIn()
        && exists(rolePath(request.auth.uid))
        && get(rolePath(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return hasAdminRole() || isLegacyOwner();
    }

    function workspaceUid() {
      return exists(ownerPath()) ? get(ownerPath()).data.uid : request.auth.uid;
    }

    // Preserve access for the administrator registered by the old setup flow.
    match /_system/owner {
      allow get: if !exists(ownerPath()) || hasAdminRole() || isLegacyOwner();
      allow list, create, update, delete: if false;
    }

    // Each signed-in user can read their own role. Only a trusted Firebase
    // Console operator or Admin SDK process can assign roles.
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;

      // Profile and appearance settings stay private to each admin. Payment
      // settings are part of the shared workspace.
      match /settings/{settingId} {
        allow read, write: if isAdmin() && (
          request.auth.uid == userId
          || (workspaceUid() == userId && settingId == 'payment')
        );
      }

      // Business collections are shared through the original admin UID.
      match /{collection}/{document=**} {
        allow read, write: if isAdmin()
          && collection != 'settings'
          && workspaceUid() == userId;
      }
    }

    // Deny everything else unless a narrowly scoped rule is added later.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
